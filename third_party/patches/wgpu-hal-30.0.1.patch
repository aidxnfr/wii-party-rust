+/// LOCAL PATCH (Wii Party wprt-gx, claude-gx): sampler MipLODBias for the next `create_sampler` on this thread, as f32 bits.
+/// D3D11/Vulkan/D3D12 samplers have a LOD bias field that wgpu 30 always sets to 0; GX texture LOD bias needs it exactly.
+#[cfg(any(dx12, vulkan))]
+pub mod lod_bias_patch {
+    use core::cell::Cell;
+    std::thread_local! { static NEXT: Cell<f32> = const { Cell::new(0.0) }; }
+    /// Set the bias used by the next sampler created on this thread (reset to 0 by the backend after use).
+    pub fn set_next_sampler_lod_bias(bias: f32) { NEXT.with(|c| c.set(bias)); }
+    pub fn take_next_sampler_lod_bias() -> f32 { NEXT.with(|c| c.replace(0.0)) }
+}
